# 本机开发环境变量模板：复制为 .env 后按需修改。
# .env 已在 .gitignore 中忽略，不会提交；本文件用于说明有哪些变量。
#
# 生产环境不读这个文件，由 systemd 的 EnvironmentFile（/etc/loombot/loombot.env）注入同名变量。

DB_HOST=localhost
DB_PORT=3306
DB_NAME=bot
DB_USER=root
DB_PASSWORD=change-me

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 签名密钥，HMAC-SHA256 至少 32 字节。漏配时应用拒绝启动。
JWT_SECRET=change-me-at-least-32-bytes-random

# 插件持久化根目录。相对路径按 Python 运行时的工作目录解析；
# 生产环境建议显式设置绝对路径，例如 /opt/loombot/shared/plugin-data。
# 只在没有 PLUGIN_STORAGE_BASE_URL 时使用（即单独跑 Python 运行时做开发）。
PLUGIN_DATA_ROOT=plugin-data

# 插件持久化后端。Java 启动 Python 运行时进程时会自己把这两项下发给孩子进程，
# 所以本机开发留空即可（Java 用默认的 http://127.0.0.1:8080/internal/plugin-storage）。
#
# 只有在"不经过 Java、手工单独启动 Python 运行时"时才需要显式填写；两者都没有时，
# Python 会回退到 PLUGIN_DATA_ROOT 下的本机文件后端（数据不进 MySQL，也不跨实例共享）。
PLUGIN_STORAGE_BASE_URL=
PLUGIN_STORAGE_CONTROL_TOKEN=

# 对象存储（文件内容）的落地根目录。当前是本地目录实现，
# 生产环境建议显式设置绝对路径，例如 /opt/loombot/shared/plugin-objects。
PLUGIN_OBJECT_ROOT=python/plugin-objects

# 注意：注册默认角色、是否重建库、是否写日志邮件都由 profile 决定，不在这里配。
# 本机默认走 dev profile（注册给 OWNER、重启重建库、验证码写日志）；
# 生产用 SPRING_PROFILES_ACTIVE=prod（注册给 USER、禁止重建库、必须配置 MAIL_*）。
