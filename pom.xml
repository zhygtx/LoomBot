<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
    </parent>

    <groupId>com.loombot</groupId>
    <artifactId>loombot</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <jjwt.version>0.13.0</jjwt.version>
        <tomlj.version>2.2.0</tomlj.version>

        <!-- 工程约束工具版本 -->
        <spotless.version>3.10.2</spotless.version>
        <google-java-format.version>1.36.1</google-java-format.version>
        <lombok.version>1.18.46</lombok.version>

    </properties>

    <dependencies>
        <!-- Web MVC + 内嵌 Tomcat（Boot 4 中 spring-boot-starter-web 已废弃，改用 webmvc） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Spring Security：HTTP 鉴权 + WS 握手鉴权 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- 邮件：注册验证码 / 找回密码验证码 / 断联通知。
             ⚠️ 同 Flyway 的教训 —— 必须用 starter，只加 jakarta.mail 不会触发 Boot 4 的
                自动配置，而且失败是静默的（见 environment.md 第 20 条）。
             配了 spring.mail.host 才会有 JavaMailSender bean；没配时 MailConfig 走
                 LoggingMailSender（把邮件内容写日志，供本机开发用），见 docs/decisions.md D53。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- JWT：登录令牌的签名与校验。
             三个 artifact 缺一不可 —— api 是编译期接口，impl 与 jackson 是运行期实现，
             jjwt 用 SPI 在运行时发现它们（只加 api 会在运行期抛 UnsupportedJwtException）。
             jackson 扩展依赖 Jackson 2，与本工程 Boot 4 的 Jackson 3 并存是有意为之，
             jjwt 的 jackson 扩展仍是 Jackson 2，与 Boot 4 的 Jackson 3 并存是有意为之。 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Actuator：健康检查 / 指标，供容器探针与监控使用 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 参数校验：@Valid / @NotNull 等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Redis：缓存 / 会话 / 分布式状态 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- MyBatis-Plus：Boot 4 必须用 boot4-starter，boot3-starter 不兼容 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- 分页插件所需的 JSqlParser。
             ⚠️ MyBatis-Plus 3.5.9 起把分页拦截器从 mybatis-plus-extension 挪到了这个
                可选模块。不加它，PaginationInnerInterceptor 会在运行时抛
                NoClassDefFoundError；更糟的是如果干脆不注册拦截器，selectPage 会
                静默地全表返回且 total=0 —— 一个不报错的分页 bug。
             选非 -4.9 版本：-4.9 是给 JDK 8 用的 JSqlParser 4.x，本工程是 Java 21。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- Lombok：消灭样板代码（getter/setter/构造器/日志字段）。

             ⚠️ 三条必须一起配，少一条就会踩坑：

             1) optional=true —— Lombok 是**编译期**注解处理器，不该传递到使用方的
                classpath。打成普通依赖会让下游项目莫名多出一个 jar。
             2) annotationProcessorPaths 显式声明 —— 不写的话，JDK 21 下编译器会走
                「classpath 上的处理器自动发现」，那个机制已被标记为将来会禁用
                （javac 会告警 "Annotation processing is enabled because one or more
                processors were found on the class path"）。显式声明还有个好处：
                处理器版本与依赖版本由同一处属性控制，不会漂移。
             3) spring-boot-maven-plugin 的 excludes —— 否则 repackage 会把 Lombok
                打进 fat jar。它只在编译期有用，运行时留在包里纯属负担（也容易被
                安全扫描误报）。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Flyway：数据库迁移。启动时自动执行 db/migration 下未应用的脚本，
             用 flyway_schema_history 表记录版本，替代「手动跑 SQL + 靠记忆」。

             ⚠️ 必须用 spring-boot-starter-flyway，不能只加 flyway-core！
                Spring Boot 4 把自动配置拆成了独立模块（spring-boot-flyway 等），
                只放第三方 jar 到 classpath 不会触发任何迁移 —— 而且不报错，
                表现为「应用正常启动但一张表都没建」，极难排查。
             flyway-mysql 需单独加：Flyway 10 起把各数据库方言拆成了独立 artifact。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- MySQL 驱动：仅运行期需要，编译期不直接引用 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 插件元信息读取。plugin.toml 是插件契约的一部分，不靠手写字符串解析。 -->
        <dependency>
            <groupId>org.tomlj</groupId>
            <artifactId>tomlj</artifactId>
            <version>${tomlj.version}</version>
        </dependency>

    </dependencies>

    <build>
        <finalName>loombot</finalName>
        <plugins>
            <!-- 编译器：显式声明注解处理器路径。
                 不写这段的话，JDK 21 会从 classpath 自动发现处理器并打印告警，
                 而那个机制已被标记为将来要移除。显式声明同时也让「谁在参与编译」
                 变成 pom 里看得见的事实。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Lombok 只在编译期有用，打进 fat jar 是纯粹的负担 -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- 代码格式化：提交前统一风格，消灭格式分歧。
                 check 挂在 validate 阶段 —— 格式不对直接构建失败，而不是靠自觉。 -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                            <!-- AOSP 风格：4 空格缩进、100 列，比默认的 2 空格更符合国内习惯 -->
                            <style>AOSP</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
