  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "prettier": "^3.9.9",
    "typescript": "6.0.3",
    "vite": "^8.3.1",
    "vue-tsc": "^3.3.11"
  }
