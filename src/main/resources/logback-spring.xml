<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 定义日志文件的存储路径 -->
    <property name="LOG_HOME" value="./logs" />

    <!-- 应用启动时间戳 -->
    <timestamp key="APP_START" datePattern="yyyy-MM-dd_HH-mm-ss"/>

    <!--
      日志格式中的 %X{traceId:-} 从 MDC 取 TraceId（见 TraceContext），
      「:-」表示取不到时留空，避免定时任务等非请求线程打印出 "traceId=" 这样的残缺字段。

      控制台额外输出 %thread，因为排查问题时最常问的是「哪个线程干的」。
    -->
    <property name="CONSOLE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId:-}] %-5level %logger{50} - %msg%n"/>
    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId:-}] %-5level %logger{50} - %msg%n"/>

    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 按启动时间命名 + 按天和大小滚动的日志 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_START}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 滚动文件格式：启动时间_日期_序号 -->
            <fileNamePattern>${LOG_HOME}/${APP_START}_%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>30MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 异步写文件：避免磁盘 IO 阻塞业务线程。
         discardingThreshold=0 表示队列满时也不丢弃任何日志（宁可阻塞也不丢，排查问题优先）。 -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE" />
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>

    <logger name="com.loom" level="DEBUG" />

    <!--
      定时任务和它们触发的 SQL 不要刷屏：
      - 连接状态同步每 2 秒跑一次
      - 插件仓库扫描每 30 秒跑一次
      - Mapper 的 DEBUG 会打印每条 SQL 和参数
      这些调到 WARN，保留错误和警告；需要排查 SQL 时再临时调回 DEBUG。
    -->
    <logger name="com.loom.connection.mapper" level="WARN" />
    <logger name="com.loom.plugin.mapper" level="WARN" />
    <logger name="com.loom.auth.mapper" level="WARN" />
    <logger name="com.loom.system.mapper" level="WARN" />
    <logger name="com.loom.workflow.mapper" level="WARN" />
    <logger name="com.loom.connection.sync.ConnectionRuntimeSyncService" level="WARN" />
    <logger name="com.loom.plugin.service.PluginSyncService" level="WARN" />
    <logger name="com.loom.plugin.sync" level="WARN" />

    <!-- 根日志级别配置 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="ASYNC_FILE" />
    </root>
</configuration>
